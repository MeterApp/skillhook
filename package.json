{
  "name": "@meterapp/skillhook",
  "version": "0.3.0",
  "description": "Make your Agent Skills reactive. A permanent, secure webhook endpoint on your own machine that runs SKILL.md files with Claude Code or Codex the moment something happens, plus version-controlled schedules for the work that has no trigger. Webhook in, agent out.",
  "license": "MIT",
  "author": "Meter <hello@meterapp.co> (https://meterapp.co)",
  "homepage": "https://github.com/MeterApp/skillhook#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MeterApp/skillhook.git"
  },
  "bugs": {
    "url": "https://github.com/MeterApp/skillhook/issues"
  },
  "keywords": [
    "webhook",
    "webhooks",
    "event-driven",
    "reactive",
    "agent",
    "agent-skills",
    "skills",
    "claude-code",
    "codex",
    "mcp",
    "mcp-server",
    "tailscale",
    "automation",
    "granola",
    "sentry",
    "cli"
  ],
  "type": "module",
  "bin": {
    "skillhook": "dist/cli.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "examples",
    "schema",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "clean": "rm -rf dist",
    "dev": "tsx src/cli.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run typecheck && npm test && npm run build && npm run schema -- --check && npm run release -- --check",
    "prepublishOnly": "npm run check",
    "release": "tsx scripts/release.ts",
    "schema": "tsx scripts/generate-schema.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.0.0",
    "yaml": "^2.9.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.1"
  }
}
